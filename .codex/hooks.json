{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && exec bash .codex/hooks/pre-commit-check.sh'",
            "statusMessage": "Running pre-commit checks"
          }
        ]
      }
    ]
  }
}
